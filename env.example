# Realtime presence (the Pokemon bar). Both are safe to expose: the anon key
# is a public client key, and NEXT_PUBLIC_* is inlined into the browser
# bundle at build time either way.
#
# Copy to .env.local for local dev, and add both as repository secrets so the
# GitHub Pages build can inline them. Without them the bar still renders —
# you just never see anyone else.
#
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
